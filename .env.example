# Copy to .env. Model ids are "provider:model"; no prefix means OpenRouter.
OPENROUTER_API_KEY=          # openai/gpt-6-luna and other OpenRouter models
REVRES_VLLM_KEY=             # bearer key for your own vLLM endpoint (scripts/modal_vllm.py)
GEMINI_API_KEY=              # optional: gemini:<model>
MISTRAL_API_KEY=             # optional: mistral:<model>
GROQ_API_KEY=                # optional: groq:<model>
NVIDIA_API_KEY=              # optional: nvidia:<model>
REVRES_MODAL_URL_TEMPLATE=   # optional: https://<workspace>--{app}-serve.<region>.modal.run/v1 for your own Modal deployment
